# Hoosa environment. Copy to .env.local and fill in.
# Never commit real secrets. DB password NEVER goes in chat or the repo.

# --- Supabase (client-safe) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# --- Supabase (server-only, NEVER exposed to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Search (buyer storefront) - added in the search phase ---
# NEXT_PUBLIC_TYPESENSE_HOST=
# TYPESENSE_ADMIN_API_KEY=

# --- Payments (added in the payments phase) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
